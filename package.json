{
  "name": "starlink-card",
  "version": "1.0.1",
  "description": "Animated Lovelace card for the native Home Assistant Starlink integration, in the spirit of vacuum-card.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "starlink",
    "custom-card"
  ],
  "module": "starlink-card.js",
  "type": "module",
  "license": "MIT",
  "author": "Hudson Brendon <contato.hudsonbrendon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hudsonbrendon/starlink-card.git"
  },
  "scripts": {
    "build": "rollup -c",
    "start": "rollup -c --watch",
    "lint": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.{ts,json}\"",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "home-assistant-js-websocket": "^9.4.0",
    "lit": "^3.1.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@rollup/plugin-url": "^8.0.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.3.3",
    "rollup": "^4.30.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
